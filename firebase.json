{
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "hosting": [
    {
      "target": "app",
      "public": "build/web",
      "cleanUrls": true,
      "ignore": [
        "firebase.json",
        "**/.*",
        "**/node_modules/**"
      ],
      "rewrites": [
        {
          "source": "/privacy",
          "destination": "/privacy.html"
        },
        {
          "source": "**",
          "destination": "/index.html"
        }
      ],
      "headers": [
        {
          "source": "**/*.@(png|jpg|jpeg|gif|svg|ico)",
          "headers": [
            { "key": "Cache-Control", "value": "public, max-age=86400" }
          ]
        },
        {
          "source": "**/*.@(js|css|woff2|wasm)",
          "headers": [
            { "key": "Cache-Control", "value": "public, max-age=300, must-revalidate" }
          ]
        },
        {
          "source": "/canvaskit/**",
          "headers": [
            { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
          ]
        },
        {
          "source": "**/flutter_service_worker.js",
          "headers": [
            { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }
          ]
        },
        {
          "source": "**/flutter_bootstrap.js",
          "headers": [
            { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }
          ]
        },
        {
          "source": "**/manifest.json",
          "headers": [
            { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }
          ]
        },
        {
          "source": "**/version.json",
          "headers": [
            { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }
          ]
        },
        {
          "source": "**/index.html",
          "headers": [
            { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }
          ]
        },
        {
          "source": "/",
          "headers": [
            { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }
          ]
        }
      ]
    },
    {
      "target": "marketing",
      "public": "marketing",
      "cleanUrls": true,
      "ignore": [
        "firebase.json",
        "**/.*",
        "**/node_modules/**"
      ],
      "redirects": [
        {
          "source": "https://www.likehim.app/**",
          "destination": "https://likehim.app/:splat",
          "type": 301
        }
      ],
      "headers": [
        {
          "source": "**/*.@(png|jpg|jpeg|gif|svg|ico|webp)",
          "headers": [
            { "key": "Cache-Control", "value": "public, max-age=86400" }
          ]
        },
        {
          "source": "**/*.@(css|woff2)",
          "headers": [
            { "key": "Cache-Control", "value": "public, max-age=300, must-revalidate" }
          ]
        },
        {
          "source": "**/index.html",
          "headers": [
            { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }
          ]
        },
        {
          "source": "/",
          "headers": [
            { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }
          ]
        }
      ]
    }
  ],
  "flutter": {
    "platforms": {
      "android": {
        "default": {
          "projectId": "like-him-app",
          "appId": "1:202035979322:android:702011578c23e6057fc103",
          "fileOutput": "android/app/google-services.json"
        }
      },
      "dart": {
        "lib/firebase_options.dart": {
          "projectId": "like-him-app",
          "configurations": {
            "android": "1:202035979322:android:702011578c23e6057fc103",
            "ios": "1:202035979322:ios:4287f778a1262aa87fc103",
            "web": "1:202035979322:web:861f98a15c7abfe07fc103"
          }
        }
      }
    }
  }
}
